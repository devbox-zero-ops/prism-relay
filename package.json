{
  "name": "prism-relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prism Relay — Daily 60-second dual-wavelength optical routing puzzle for Reddit (Devvit Web)",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config vite.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview:local": "vite preview --config vite.config.ts --host 127.0.0.1 --port 4173",
    "deploy": "devvit upload",
    "playtest": "devvit playtest"
  },
  "dependencies": {
    "@devvit/web": "0.15.6",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "devvit": "0.15.6",
    "typescript": "^5.8.0",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "license": "BSD-3-Clause"
}